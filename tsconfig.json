{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "NodeNext",
		"target": "ES2024",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"noImplicitThis": true,
		"declaration": true,
		"isolatedModules": true,
		"strict": true
	},
	"include": ["./src/**/*.ts"],
	"exclude": ["node_modules"]
}
