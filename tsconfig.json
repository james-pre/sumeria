{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "NodeNext",
		"target": "ES2024",
		"moduleResolution": "NodeNext",
		"noImplicitThis": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"strict": true
	},
	"exclude": ["node_modules"],
	"files": [],
	"references": [
		{ "path": "./src/app" },
		{ "path": "./src/client" },
		{ "path": "./src/core" },
		{ "path": "./src/render" },
		{ "path": "./src/server" }
	]
}
