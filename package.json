{
	"name": "@sumeria/root",
	"private": true,
	"version": "1.0.0",
	"description": "A WIP game engine",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"license": "LGPL-3.0-or-later",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/sumeria.git"
	},
	"type": "module",
	"bugs": {
		"url": "https://github.com/james-pre/sumeria/issues"
	},
	"homepage": "https://github.com/james-pre/sumeria#readme",
	"workspaces": [
		"src/*"
	],
	"scripts": {
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"build": "cp src/client/src/ui/index.html src/client/dist/index.html && tsc -b",
		"watch": "cp src/client/src/ui/index.html src/client/dist/index.html && tsc -b -w",
		"lint": "tsc -b && eslint src tests",
		"clean": "rm -rf src/*/dist src/*/tsconfig.tsbuildinfo",
		"test": "tsc -b tests && node --test tests/dist"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@babylonjs/core": "^9.26.1",
		"@eslint/js": "^10.0.1",
		"@sumeria/app": "workspace:*",
		"@sumeria/client": "workspace:*",
		"@sumeria/core": "workspace:*",
		"@sumeria/render": "workspace:*",
		"@sumeria/server": "workspace:*",
		"@types/node": "^24.7.0",
		"eslint": "^10.1.0",
		"globals": "^17.4.0",
		"prettier": "^3.2.5",
		"socket.io-client": "^4.8.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"utilium": "^3.0.0"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 120,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	},
	"allowScripts": {
		"esbuild": true,
		"electron": true
	}
}
